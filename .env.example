# Copy to .env and fill in real values. Never commit the real .env file.
#
# Values here are placeholders. Where the code also has a Secrets Manager
# fallback (trade-platform/<env>/<name>), that's noted below — locally,
# the env var takes priority so you don't need AWS access to run things.

# --- Deployment environment (query/, query_lg/, ingestion/) -----------------
ENV=dev                          # query/*.py, query_lg/*.py — dev or prod
ENVIRONMENT=dev                  # ingestion/*.py's older scripts use this name for the same thing
ACCOUNT=<your-aws-account-id>    # used to build S3 bucket names like {env}-trade-{source}-raw-{account}
AWS_DEFAULT_REGION=us-east-2

# --- Anthropic / LangSmith (query/config.py, query_lg/models.py) -----------
ANTHROPIC_API_KEY=your-anthropic-api-key-here   # falls back to Secrets Manager trade-platform/<env>/anthropic-api-key
LANGSMITH_API_KEY=placeholder          # falls back to Secrets Manager trade-platform/<env>/langsmith-api-key
LANGSMITH_TRACING=true                 # read by the langsmith/langchain SDK directly, not by this repo's own code
LANGSMITH_PROJECT=trade-platform-lg    # read by the langsmith/langchain SDK directly

# --- query_lg server (query_lg/server.py) -----------------------------------
QUERY_LG_DB_PATH=./query_lg/checkpoints.sqlite   # LangGraph checkpointer sqlite file path

# --- Ingestion: per-source API keys (ingestion/scripts/ingest_*.py) ---------
FRED_API_KEY=placeholder         # falls back to Secrets Manager trade-platform/<env>/fred-api-key
POLYGON_API_KEY=placeholder      # falls back to Secrets Manager trade-platform/<env>/polygon-api-key
ACLED_API_KEY=placeholder
ACLED_EMAIL=you@example.com
COMTRADE_API_KEY=placeholder
EIA_API_KEY=placeholder
WTO_API_KEY=placeholder

# --- SEC / Wikipedia scraping etiquette (ingestion/scripts/, scripts/) ------
SEC_USER_AGENT="YourApp/1.0 you@example.com"   # SEC's FAIR ACCESS policy requires a real contact

# --- ETL job overrides (ingestion/etl/*.py, passed as CLI args or env) -----
REGION=us-east-2                       # etl_embed.py
CONFIG_PATH=ingestion/configs/sources/<source>.yaml   # etl_sec.py, etl_wikipedia.py, etl_worldbank.py, etl_yfinance.py
SEC_PROCESSED_BUCKET=<bucket-name>     # etl_embed.py bucket overrides
WIKI_PROCESSED_BUCKET=<bucket-name>
PROSE_BUCKET=<bucket-name>
FEDSPEAK_PROCESSED_BUCKET=<bucket-name>
VECTOR_BUCKET=<bucket-name>
