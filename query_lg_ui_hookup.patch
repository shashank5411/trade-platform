+<body>
+
+<div class="main-header">
+  <div class="main-header-left">
+    <div class="main-header-title">Trade Platform <span class="main-header-badge">LangGraph</span></div>
+    <div class="main-header-sid" id="header-sid"></div>
+  </div>
+  <button class="btn-new-chat" onclick="newChat()">+ New Chat</button>
+</div>
+
+<div class="messages" id="messages">
+  <div class="empty-state" id="empty-state">
+    <div class="empty-state-text">Ask a question to get started</div>
+    <div class="empty-state-sub">query_lg — plan-and-execute graph, market · macro · filings · sentiment</div>
+  </div>
+</div>
+
+<div class="input-area">
+  <div class="input-row">
+    <textarea id="question" placeholder="Ask about markets, macro, filings, insider activity…" rows="1"></textarea>
+    <button class="btn-send" id="submit">Send</button>
+  </div>
+  <div class="input-hint" id="input-hint">Ctrl+Enter to send</div>
+</div>
+
+<script>
+// ── Session ID — "lg-" prefixed so this system's threads stay
+// distinguishable from V1's session_ids if ever compared side by side ──
+function generateSessionId() {
+  const uuid = (crypto && crypto.randomUUID)
+    ? crypto.randomUUID()
+    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
+        const r = Math.random() * 16 | 0;
+        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
+      });
+  return 'lg-' + uuid;
+}
+function getSessionFromUrl() {
+  const m = window.location.pathname.match(/^\/chat\/(lg-[\w-]+)$/);
+  return m ? m[1] : null;
+}
+function pushSessionUrl(sid) {
+  const url = `/chat/${sid}`;
+  if (window.location.pathname !== url) history.pushState({ sessionId: sid }, '', url);
+}
+
+const _urlSessionId = getSessionFromUrl();
+let sessionId = _urlSessionId || localStorage.getItem('trade_lg_session_id') || generateSessionId();
+localStorage.setItem('trade_lg_session_id', sessionId);
+if (!_urlSessionId) pushSessionUrl(sessionId);
+
+let _busy = false;
+// Set whenever /ask or /resume returns needs_clarification=true — the
+// NEXT send goes to /resume instead of /ask, continuing the same paused
+// graph run rather than starting a fresh one.
+let _awaitingClarification = false;
+
+const messagesEl = document.getElementById('messages');
+const emptyEl    = document.getElementById('empty-state');
+const submitEl   = document.getElementById('submit');
+const questionEl = document.getElementById('question');
+const hintEl     = document.getElementById('input-hint');
+
+function updateHeaderSid() {
+  document.getElementById('header-sid').textContent = sessionId;
+}
+
+function escHtml(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
+
+function appendBubble(role, content, opts = {}) {
+  const wrap = document.createElement('div');
+  wrap.className = `msg ${role}`;
+  const roleEl = document.createElement('div');
+  roleEl.className = 'msg-role';
+  roleEl.textContent = role === 'user' ? 'You' : 'Agent';
+  const bubble = document.createElement('div');
+  bubble.className = 'msg-bubble' + (opts.clarify ? ' clarify' : '');
+  if (role === 'assistant') {
+    bubble.innerHTML = marked.parse(content || '');
+  } else {
+    bubble.textContent = content;
+  }
+  wrap.appendChild(roleEl);
+  wrap.appendChild(bubble);
+  if (opts.clarify) {
+    const banner = document.createElement('div');
+    banner.className = 'clarify-banner';
+    banner.textContent = 'Waiting on your answer to continue';
+    wrap.appendChild(banner);
+  }
+  const typing = messagesEl.querySelector('.typing-wrap');
+  if (typing) messagesEl.insertBefore(wrap, typing);
+  else messagesEl.appendChild(wrap);
+  messagesEl.scrollTop = messagesEl.scrollHeight;
+  return { bubble, wrap };
+}
+
+function showTyping() {
+  const wrap = document.createElement('div');
+  wrap.className = 'msg assistant typing-wrap';
+  const roleEl = document.createElement('div');
+  roleEl.className = 'msg-role';
+  roleEl.textContent = 'Agent';
+  const b = document.createElement('div');
+  b.className = 'typing';
+  b.innerHTML = '<span></span><span></span><span></span>';
+  wrap.appendChild(roleEl);
+  wrap.appendChild(b);
+  messagesEl.appendChild(wrap);
+  messagesEl.scrollTop = messagesEl.scrollHeight;
+  return wrap;
+}
+function hideTyping(el) { if (el && el.parentNode) el.parentNode.removeChild(el); }
+
+questionEl.addEventListener('input', () => {
+  questionEl.style.height = '44px';
+  questionEl.style.height = Math.min(questionEl.scrollHeight, 160) + 'px';
+  questionEl.style.overflowY = questionEl.scrollHeight > 160 ? 'auto' : 'hidden';
+});
+
+async function ask() {
+  const text = questionEl.value.trim();
+  if (!text || _busy) return;
+  _busy = true;
+  submitEl.disabled = true;
+  questionEl.value = '';
+  questionEl.style.height = '44px';
+  if (emptyEl) emptyEl.style.display = 'none';
+  appendBubble('user', text);
+  const typingEl = showTyping();
+
+  const wasResuming = _awaitingClarification;
+  const url = wasResuming ? '/resume' : '/ask';
+  const body = wasResuming
+    ? { session_id: sessionId, answer: text }
+    : { question: text, session_id: sessionId };
+
+  try {
+    const res = await fetch(url, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(body),
+    });
+    hideTyping(typingEl);
+    if (!res.ok) throw new Error(`${res.status}`);
+    const data = await res.json();
+
+    if (data.error) throw new Error(data.error);
+
+    if (data.needs_clarification) {
+      _awaitingClarification = true;
+      appendBubble('assistant', data.clarify_question || 'Can you clarify?', { clarify: true });
+      hintEl.textContent = 'Answering a clarifying question — Ctrl+Enter to send';
+    } else {
+      _awaitingClarification = false;
+      appendBubble('assistant', data.answer || '(no answer returned)');
+      hintEl.textContent = 'Ctrl+Enter to send';
+    }
+  } catch (err) {
+    hideTyping(typingEl);
+    const { bubble } = appendBubble('assistant', 'Something went wrong — try again.');
+    bubble.classList.add('error');
+  } finally {
+    _busy = false;
+    submitEl.disabled = false;
+    questionEl.focus();
+  }
+}
+
+function newChat() {
+  sessionId = generateSessionId();
+  localStorage.setItem('trade_lg_session_id', sessionId);
+  pushSessionUrl(sessionId);
+  _awaitingClarification = false;
+  Array.from(messagesEl.children).forEach(el => { if (el !== emptyEl) el.remove(); });
+  if (emptyEl) emptyEl.style.display = '';
+  hintEl.textContent = 'Ctrl+Enter to send';
+  updateHeaderSid();
+  questionEl.focus();
+}
+
+updateHeaderSid();
+questionEl.focus();
+
+window.addEventListener('popstate', e => {
+  const sid = (e.state && e.state.sessionId) || getSessionFromUrl();
+  if (sid && sid !== sessionId) { sessionId = sid; localStorage.setItem('trade_lg_session_id', sid); updateHeaderSid(); }
+  else if (!sid) newChat();
+});
+
+submitEl.addEventListener('click', ask);
+questionEl.addEventListener('keydown', e => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) ask(); });
+</script>
+</body>
+</html>